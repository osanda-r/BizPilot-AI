# Optional: get a key from https://console.groq.com/keys. Never put it in frontend code.
# Leave empty to use the clearly labelled, English-language local rule fallback.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=20

# Relative paths are resolved from the directory where uvicorn is started.
DATABASE_PATH=data/bizpilot.db
# Only needed for a separately hosted frontend. The dev proxy uses same-origin requests.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
